DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DJANGO_DEBUG=True
# Em produção, inclua o(s) domínio(s) reais, ex.: fabrica.ifma.edu.br
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção (atrás de proxy HTTPS), inclua a origem completa com esquema,
# ex.: https://fabrica.ifma.edu.br — necessário para o Django aceitar POSTs
# (como o login) vindos desse domínio.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Se o app roda numa subpasta (ex.: https://fabrica.ifma.edu.br/painel_inovacao/),
# defina o prefixo aqui. O proxy reverso deve remover esse prefixo antes de
# repassar a requisição ao container. Deixe vazio se o app roda na raiz do domínio.
DJANGO_FORCE_SCRIPT_NAME=
DJANGO_PORT=8013

# Porta do host para o app "Mapa de Competências" (observatorio/), rodando
# em modo dev (pnpm dev / vinext).
OBSERVATORIO_PORT=5173

POSTGRES_DB=painel_inovacao
POSTGRES_USER=painel_inovacao
POSTGRES_PASSWORD=painel_inovacao
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme
